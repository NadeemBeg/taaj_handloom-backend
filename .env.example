# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─── URLs / CORS (allowlist, comma-separated) ──────────────
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# ─── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/taaj_handloom

# ─── Auth / JWT (use long random strings — DO NOT reuse these) ──
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=change_me_cookie_secret

# ─── Initial admin seed (used once by `npm run seed:admin`) ──
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@taajhandloom.com
SEED_ADMIN_PASSWORD=change_me_strong_password

# ─── Business / WhatsApp (country code, no +) ──────────────
WHATSAPP_NUMBER=917509724030

# Reserve stock when an order is placed (prevents oversell). Default false.
ORDER_RESERVE_STOCK=false

# ─── Cloudinary (image storage) ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Redis (optional — leave blank to disable) ─────────────
REDIS_URL=

# ─── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
